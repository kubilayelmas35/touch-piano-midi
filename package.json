{
  "name": "staveflow",
  "version": "1.1.0",
  "description": "StaveFlow — Piano, guitar & violin with falling MIDI notes",
  "main": "electron/main.js",
  "scripts": {
    "bundle": "node scripts/bundle-renderer.js",
    "build:pages": "node scripts/build-pages.js",
    "prestart": "node scripts/bundle-renderer.js",
    "start": "electron .",
    "pack": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28"
  },
  "build": {
    "appId": "com.staveflow.app",
    "productName": "StaveFlow",
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": ["portable"]
    },
    "files": ["electron/**/*", "src/**/*", "package.json"]
  }
}
