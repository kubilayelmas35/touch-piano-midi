{
  "name": "sonatrio",
  "productName": "Sonatrio",
  "private": true,
  "version": "2.3.9",
  "description": "Sonatrio — piano, guitar & violin with falling MIDI notes",
  "author": "Sonatrio",
  "homepage": "https://sonatrio.com",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node tools/clean-docs.mjs && node tools/licenses.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "samples": "node tools/fetch-samples.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win --publish never",
    "steam:dist": "npm run build && electron-builder --win dir --publish never && node scripts/steam-appid.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:aab": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "ios:sync": "npm run build && cap sync ios && node tools/strip-ios-videos.mjs"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/native-purchases": "^8.8.1",
    "@spotify/basic-pitch": "^1.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tonejs/midi": "^2.0.28",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
